project('slipstream5000', 'c', version: '0.1.0', meson_version: '>=1.3.0',
  default_options: ['c_std=c11', 'warning_level=2'])

cc = meson.get_compiler('c')
add_project_arguments('-DSLIP_ASSERT_TO_STDERR', '-DSDL_MAIN_HANDLED', language: 'c')
if host_machine.system() == 'windows'
  add_project_arguments('-D_CRT_SECURE_NO_WARNINGS', language: 'c')
endif

sdl3_dir = get_option('sdl3_dir')
if sdl3_dir != ''
  sdl3 = declare_dependency(
    include_directories: include_directories(sdl3_dir / 'include'),
    dependencies: cc.find_library('SDL3', dirs: sdl3_dir / 'lib64'))
  if host_machine.system() == 'windows'
    configure_file(input: sdl3_dir / 'lib64' / 'SDL3.dll', output: 'SDL3.dll', copy: true)
  endif
else
  sdl3 = dependency('sdl3', version: '>=3.2.0', method: 'pkg-config', required: false)
  if not sdl3.found()
    sdl3 = dependency('SDL3', version: '>=3.2.0', method: 'cmake', modules: ['SDL3::SDL3'])
  endif
endif
math = cc.find_library('m', required: false)
platform_dependencies = [sdl3, math]
if host_machine.system() == 'windows'
  platform_dependencies += cc.find_library('advapi32')
endif

sources = files(
  'src/port/actor_access.c',
